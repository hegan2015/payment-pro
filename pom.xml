<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.qoder.payment</groupId>
    <artifactId>payment-pro</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>payment-pro</name>
    <description>参考支付宝领域划分的工业级支付系统：Spring Boot + Dubbo + 自研 XTS 风格 TCC</description>

    <modules>
        <module>tcc-core</module>
        <module>payment-common</module>
        <module>payment-facade</module>
        <module>payment-registry</module>
        <module>payment-member</module>
        <module>payment-account</module>
        <module>payment-accounting</module>
        <module>payment-trade</module>
        <module>payment-channel</module>
        <module>payment-risk</module>
        <module>payment-cashier</module>
        <module>payment-payment</module>
        <module>payment-settle</module>
        <module>payment-notify</module>
        <module>payment-recon</module>
        <!-- P2 X-3a/X-3b 营销域（A 泳道）：第 14 进程，Dubbo 20893 / actuator 18093；
             不纳入网关 HealthService 的 13 进程清单，既有 13/13 硬断言不变 -->
        <module>payment-marketing</module>
        <module>payment-gateway</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <dubbo.version>3.2.14</dubbo.version>
        <mybatis-starter.version>3.0.3</mybatis-starter.version>
        <zookeeper.version>3.8.4</zookeeper.version>
        <rocketmq.version>5.1.4</rocketmq.version>
        <!-- I-3 XXL-Job（F 泳道）：与共享栈 xxl-job-admin 2.4.1 对齐；wave3-H 持锁期间代为补齐版本管理以解构建阻塞 -->
        <xxl-job.version>2.4.1</xxl-job.version>
        <!-- I-3 ShedLock（F 泳道）：Java17/Spring Boot 3.2 兼容线；wave3-H 持锁期间代为补齐版本管理以解构建阻塞 -->
        <shedlock.version>5.13.0</shedlock.version>
        <!-- I-2 Apollo（E 泳道）/ I-7 Sentinel（G 泳道）：wave3-H 持锁期间代为补齐版本管理以解构建阻塞 -->
        <apollo.version>2.2.0</apollo.version>
        <sentinel.version>1.8.7</sentinel.version>
        <!-- I-5a ShardingSphere-JDBC（非资金域 settle/recon 试点）：5.5.0 支持 Spring Boot 3.2 / Java17，
             含 sharding / readwrite-splitting / single 规则与 Standalone JDBC 元数据仓库 -->
        <shardingsphere.version>5.5.0</shardingsphere.version>
        <!-- I-5a workerId 分配用 Curator：与 Dubbo 3.2.14 自带 curator 线一致，避免版本分裂 -->
        <curator.version>5.1.0</curator.version>
        <!-- R-1 QLExpress（B 泳道）：p1-D 持锁期间代为补齐版本管理以解全 reactor POM 解析阻塞（additive） -->
        <qlexpress.version>3.3.3</qlexpress.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-bom</artifactId>
                <version>${dubbo.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.qoder.payment</groupId>
                <artifactId>payment-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.qoder.payment</groupId>
                <artifactId>payment-facade</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.qoder.payment</groupId>
                <artifactId>tcc-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mybatis.spring.boot</groupId>
                <artifactId>mybatis-spring-boot-starter</artifactId>
                <version>${mybatis-starter.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.rocketmq</groupId>
                <artifactId>rocketmq-client</artifactId>
                <version>${rocketmq.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xuxueli</groupId>
                <artifactId>xxl-job-core</artifactId>
                <version>${xxl-job.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-core</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ctrip.framework.apollo</groupId>
                <artifactId>apollo-client</artifactId>
                <version>${apollo.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-core</artifactId>
                <version>${sentinel.version}</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-parameter-flow-control</artifactId>
                <version>${sentinel.version}</version>
            </dependency>
            <!-- Spring Boot 3/jakarta 必须用 6x adapter（同包名 webmvc，内部 jakarta.servlet）；
                 6x 线 Central 仅发布到 1.8.6，与 sentinel-core 1.8.7 API 兼容 -->
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-spring-webmvc-6x-adapter</artifactId>
                <version>1.8.6</version>
            </dependency>
            <dependency>
                <groupId>com.alibaba.csp</groupId>
                <artifactId>sentinel-apache-dubbo-adapter</artifactId>
                <version>${sentinel.version}</version>
            </dependency>
            <!-- I-5a：ShardingSphere-JDBC（仅 payment.sharding.enabled=true 时装配 Bean，local 不加载不连接） -->
            <dependency>
                <groupId>org.apache.shardingsphere</groupId>
                <artifactId>shardingsphere-jdbc</artifactId>
                <version>${shardingsphere.version}</version>
                <!-- 5.5.0 上游打包缺陷：test-* 制品被以 compile 传递但未发布到 Central，
                     这里显式排除（只排测试夹具，不影响任何运行期能力） -->
                <exclusions>
                    <exclusion>
                        <groupId>org.apache.shardingsphere</groupId>
                        <artifactId>shardingsphere-test-util</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.apache.shardingsphere</groupId>
                        <artifactId>shardingsphere-test-fixture-database</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>org.apache.shardingsphere</groupId>
                        <artifactId>shardingsphere-test-it-yaml</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.apache.curator</groupId>
                <artifactId>curator-framework</artifactId>
                <version>${curator.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.dubbo</groupId>
                <artifactId>dubbo-dependencies-zookeeper-curator5</artifactId>
                <version>${dubbo.version}</version>
                <type>pom</type>
                <exclusions>
                    <exclusion>
                        <groupId>org.slf4j</groupId>
                        <artifactId>slf4j-log4j12</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>log4j</groupId>
                        <artifactId>log4j</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>ch.qos.reload4j</groupId>
                        <artifactId>reload4j</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <dependency>
                <groupId>org.apache.zookeeper</groupId>
                <artifactId>zookeeper</artifactId>
                <version>${zookeeper.version}</version>
                <exclusions>
                    <exclusion>
                        <groupId>org.slf4j</groupId>
                        <artifactId>slf4j-log4j12</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>log4j</groupId>
                        <artifactId>log4j</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>ch.qos.reload4j</groupId>
                        <artifactId>reload4j</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>ch.qos.logback</groupId>
                        <artifactId>logback-classic</artifactId>
                    </exclusion>
                    <exclusion>
                        <groupId>ch.qos.logback</groupId>
                        <artifactId>logback-core</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>
            <!-- R-1 规则引擎 QLExpress（B 泳道）：p1-D 持锁期间代为补齐版本管理（additive，不改既有项） -->
            <dependency>
                <groupId>com.alibaba</groupId>
                <artifactId>QLExpress</artifactId>
                <version>${qlexpress.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>repackage</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>