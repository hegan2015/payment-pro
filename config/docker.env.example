# payment-pro Docker 中间件连接配置模板。
# 复制到仓库外并填真实口令（勿提交真实口令）：
#   mkdir -p ~/.config/payment-pro && chmod 700 ~/.config/payment-pro
#   cp config/docker.env.example ~/.config/payment-pro/docker.env
#   chmod 600 ~/.config/payment-pro/docker.env
# MySQL 口令与 ops-pro 共享栈一致（见 ~/.config/ops-pro/ops.properties 的 mysql.root.password）。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
# I-3 分布式调度：共享栈 XXL-Job admin（claim-shared-xxl-job-admin，宿主 8094）通讯令牌。
# 取值与 ops-pro/deploy/middleware-compose.yml 的 XXL_JOB_ACCESS_TOKEN 一致（未覆盖时为 default_token）。
# 执行器分组/端口：payment-executor:9998 / payment-notify-executor:9997 / payment-recon-executor:9996。
XXL_JOB_ACCESS_TOKEN=REPLACE_WITH_XXL_JOB_ACCESS_TOKEN
