# payment-pro Docker 中间件连接配置模板。
# 复制到仓库外并填真实口令（勿提交真实口令）：
#   mkdir -p ~/.config/payment-pro && chmod 700 ~/.config/payment-pro
#   cp config/docker.env.example ~/.config/payment-pro/docker.env
#   chmod 600 ~/.config/payment-pro/docker.env
# MySQL 口令与 ops-pro 共享栈一致（见 ~/.config/ops-pro/ops.properties 的 mysql.root.password）。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=REPLACE_WITH_STRONG_PASSWORD