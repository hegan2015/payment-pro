      "durationInSec": 1
    },
    {
      "resource": "openapi:channel.agent.pay",
      "paramIdx": 0,
      "grade": 1,
      "count": 8,
      "durationInSec": 1
    }
  ],
  "degradeRules": [
    {
      "resource": "com.qoder.payment.facade.accounting.AccountingFacade",
      "grade": 2,
      "count": 5,
      "timeWindow": 10,
      "minRequestAmount": 5,
      "statIntervalMs": 10000
    },
    {
      "resource": "com.qoder.payment.facade.payment.PaymentFacade",
      "grade": 2,
      "count": 5,
      "timeWindow": 10,
      "minRequestAmount": 5,
      "statIntervalMs": 10000
    },
    {
      "resource": "com.qoder.payment.facade.trade.TradeFacade",
      "grade": 2,
      "count": 5,
      "timeWindow": 10,
      "minRequestAmount": 5,
      "statIntervalMs": 10000
    },
    {
